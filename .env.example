# AI Provider Configuration
# Pick one:
#
# This file uses the same .env format in dev and prod:
#   dev:  repo-root .env, exported by `just devtop dev`/`serve`
#   prod: mounted /etc/devtop/.env on the devtop-ai-config volume (sourced by
#         entrypoint.sh; the chat panel rewrites it on save)
# Keep the format portable: KEY=value, one per line, # comments, no
# `export` prefix, no quotes, no $ expansion.

# Option 1: OpenRouter (cloud)
AI_API_KEY=sk-or-v1-xxx
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=deepseek/deepseek-v4-flash-0731

# Option 2: LM Studio (local)
# AI_API_KEY=not-needed
# AI_BASE_URL=http://localhost:1234/v1
# AI_MODEL=local-model

# Option 3: Any OpenAI-compatible endpoint
# AI_API_KEY=sk-...
# AI_BASE_URL=https://your-endpoint.com/v1
# AI_MODEL=model-name

# Data directory (defaults to .devtop/ relative to CWD)
# DEVTOP_DIR=./.devtop

# Persist AI config across restarts (prod). Set to 0 for session-only keys.
# DEVTOP_AI_REMEMBER=1

# Persisted AI config file on the volume (prod).
# DEVTOP_AI_ENV_FILE=/etc/devtop/.env

# MCP Servers — JSON array of server configs
# Each entry requires: name, transport (stdio or streamable-http), command+args (stdio) or url (http)
# Example — filesystem server via npx:
# MCP_SERVERS=[{"name":"filesystem","transport":"stdio","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/workspace"]}]